diff --git a/libavcodec/nvenc.c b/libavcodec/nvenc.c
index 5efd21c..7476612 100644
--- a/libavcodec/nvenc.c
+++ b/libavcodec/nvenc.c
@@ -621,6 +621,7 @@ static int nvenc_check_capabilities(AVCodecContext *avctx)
 #endif
 
     ctx->support_dyn_bitrate = nvenc_check_cap(avctx, NV_ENC_CAPS_SUPPORT_DYN_BITRATE_CHANGE);
+    ctx->dyn_bitrate_supported = ctx->support_dyn_bitrate > 0;
 
 #ifdef NVENC_HAVE_MVHEVC
     ctx->multiview_supported = nvenc_check_cap(avctx, NV_ENC_CAPS_SUPPORT_MVHEVC_ENCODE) > 0;
@@ -2938,8 +2939,10 @@ static void reconfig_encoder(AVCodecContext *avctx, const AVFrame *frame)
         }
 
         if (reconfig_bitrate) {
-            params.resetEncoder = 1;
-            params.forceIDR = 1;
+            /* With dynamic bitrate support NVENC applies a new rate without
+             * a new GOP; callers that change it often opt out of the IDR. */
+            params.resetEncoder = !ctx->idr_free_bitrate_change;
+            params.forceIDR = !ctx->idr_free_bitrate_change;
 
             needs_encode_config = 1;
             needs_reconfig = 1;
@@ -2953,7 +2956,11 @@ static void reconfig_encoder(AVCodecContext *avctx, const AVFrame *frame)
         ret = p_nvenc->nvEncReconfigureEncoder(ctx->nvencoder, &params);
         if (ret != NV_ENC_SUCCESS) {
             nvenc_print_error(avctx, ret, "failed to reconfigure nvenc");
+            if (reconfig_bitrate)
+                ctx->bitrate_reconfig_failures++;
         } else {
+            if (reconfig_bitrate)
+                ctx->bitrate_reconfigs++;
             if (reconfig_dar) {
                 ctx->init_encode_params.darHeight = dh;
                 ctx->init_encode_params.darWidth = dw;
