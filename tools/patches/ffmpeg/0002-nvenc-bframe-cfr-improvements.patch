@@ -1076,18 +1076,38 @@ static av_cold int nvenc_setup_rate_control(AVCodecContext *avctx)
         avctx->rc_buffer_size = ctx->encode_config.rcParams.vbvBufferSize = 2 * ctx->encode_config.rcParams.averageBitRate;
     }
 
-    if (ctx->aq) {
-        ctx->encode_config.rcParams.enableAQ   = 1;
-        ctx->encode_config.rcParams.aqStrength = ctx->aq_strength;
-        av_log(avctx, AV_LOG_VERBOSE, "AQ enabled.\n");
+    if (avctx->codec->id == AV_CODEC_ID_AV1 && ctx->max_qp_b >= 0) {
+        NV_ENC_RC_PARAMS *rc = &ctx->encode_config.rcParams;
+        if (rc->rateControlMode == NV_ENC_PARAMS_RC_CONSTQP) {
+            av_log(avctx, AV_LOG_VERBOSE, "max_qp_b is ignored in constant-QP mode.\n");
+        } else if (rc->enableMaxQP) {
+            rc->maxQP.qpInterB = FFMIN((int)rc->maxQP.qpInterB, ctx->max_qp_b);
+        } else {
+            rc->enableMaxQP = 1;
+            rc->maxQP.qpIntra = 255;
+            rc->maxQP.qpInterP = 255;
+            rc->maxQP.qpInterB = ctx->max_qp_b;
+        }
     }
 
-    if (ctx->temporal_aq) {
-        ctx->encode_config.rcParams.enableTemporalAQ = 1;
-        av_log(avctx, AV_LOG_VERBOSE, "Temporal AQ enabled.\n");
+    if (ctx->aq >= 0) {
+        ctx->encode_config.rcParams.enableAQ = ctx->aq;
+        if (ctx->aq) {
+            ctx->encode_config.rcParams.aqStrength = ctx->aq_strength;
+            av_log(avctx, AV_LOG_VERBOSE, "AQ enabled.\n");
+        }
     }
 
-    if (ctx->rc_lookahead > 0) {
+    if (ctx->temporal_aq >= 0) {
+        ctx->encode_config.rcParams.enableTemporalAQ = ctx->temporal_aq;
+        if (ctx->temporal_aq)
+            av_log(avctx, AV_LOG_VERBOSE, "Temporal AQ enabled.\n");
+    }
+
+    if (ctx->rc_lookahead == 0) {
+        ctx->encode_config.rcParams.enableLookahead = 0;
+        ctx->encode_config.rcParams.lookaheadDepth = 0;
+    } else if (ctx->rc_lookahead > 0) {
         int lkd_bound = FFMIN(ctx->nb_surfaces, ctx->async_depth) -
                         ctx->encode_config.frameIntervalP - 4;
 
@@ -1747,11 +1767,16 @@ static av_cold int nvenc_setup_encoder(AVCodecContext *avctx)
     ctx->init_encode_params.enableEncodeAsync = 0;
     ctx->init_encode_params.enablePTD = 1;
 
-    /* If lookahead isn't set from CLI, use value from preset.
+    /* If lookahead isn't set from CLI, use the value from the preset.
      * P6 & P7 presets may enable lookahead for better quality.
      * */
-    if (ctx->rc_lookahead == 0 && ctx->encode_config.rcParams.enableLookahead)
-        ctx->rc_lookahead = ctx->encode_config.rcParams.lookaheadDepth;
+    if (ctx->rc_lookahead < 0) {
+        ctx->rc_lookahead = ctx->encode_config.rcParams.enableLookahead ?
+                            ctx->encode_config.rcParams.lookaheadDepth : 0;
+    } else if (ctx->rc_lookahead == 0) {
+        ctx->encode_config.rcParams.enableLookahead = 0;
+        ctx->encode_config.rcParams.lookaheadDepth = 0;
+    }
 
     if (ctx->weighted_pred == 1)
         ctx->init_encode_params.enableWeightedPrediction = 1;
@@ -1797,6 +1822,14 @@ static av_cold int nvenc_setup_encoder(AVCodecContext *avctx)
     if(ctx->single_slice_intra_refresh)
         ctx->intra_refresh = 1;
 
+    if (ctx->b_ref_mode < 0) {
+        int b_ref_caps = nvenc_check_cap(avctx, NV_ENC_CAPS_SUPPORT_BFRAME_REF_MODE);
+        ctx->b_ref_mode = ctx->encode_config.frameIntervalP > 1 && (b_ref_caps & 2) ?
+                          NV_ENC_BFRAME_REF_MODE_MIDDLE : NV_ENC_BFRAME_REF_MODE_DISABLED;
+        av_log(avctx, AV_LOG_VERBOSE, "Automatic B-reference mode: %s.\n",
+               ctx->b_ref_mode == NV_ENC_BFRAME_REF_MODE_MIDDLE ? "middle" : "disabled");
+    }
+
     nvenc_recalc_surfaces(avctx);
 
     res = nvenc_setup_rate_control(avctx);
@@ -2684,8 +2717,17 @@ static int process_output_surface(AVCodecContext *avctx, AVPacket *pkt, NvencSur
     case NV_ENC_PIC_TYPE_BI:
         pict_type = AV_PICTURE_TYPE_BI;
         break;
+    case NV_ENC_PIC_TYPE_SKIPPED:
+    case NV_ENC_PIC_TYPE_INTRA_REFRESH:
+    case NV_ENC_PIC_TYPE_NONREF_P:
+        pict_type = AV_PICTURE_TYPE_P;
+        break;
+    case NV_ENC_PIC_TYPE_SWITCH:
+        pict_type = AV_PICTURE_TYPE_I;
+        break;
     default:
-        av_log(avctx, AV_LOG_ERROR, "Unknown picture type encountered, expect the output to be broken.\n");
+        av_log(avctx, AV_LOG_ERROR, "Unknown picture type %d encountered, expect the output to be broken.\n",
+               lock_params.pictureType);
         av_log(avctx, AV_LOG_ERROR, "Please report this error and include as much information on how to reproduce it as possible.\n");
         res = AVERROR_EXTERNAL;
         goto error;
