+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Copyright (c) 2026 aufkrawall
+ * Bounded AAC allocation repair. Callbacks own the codec's candidate/band state.
+ */
+#ifndef AVCODEC_AACENC_NMR_BUDGET_H
+#define AVCODEC_AACENC_NMR_BUDGET_H
+
+typedef struct AACNMRBudgetOps {
+    void *context;
+    int (*measure)(void *context);
+    void (*coarsen)(void *context);
+    int (*remove_highest)(void *context);
+} AACNMRBudgetOps;
+
+typedef struct AACNMRBudgetResult {
+    int bits;
+    int coarsened;
+    int removed;
+} AACNMRBudgetResult;
+
+/* Every removal consumes a band, even if repairing its scalefactor edge costs
+ * extra bits. Bound work by the band's finite count, not by elapsed time. */
+static inline AACNMRBudgetResult ff_aac_nmr_fit_budget(const AACNMRBudgetOps *ops,
+                                                       int budget, int max_removals)
+{
+    AACNMRBudgetResult result = { ops->measure(ops->context), 0, 0 };
+    if (result.bits <= budget)
+        return result;
+    ops->coarsen(ops->context);
+    result.coarsened = 1;
+    result.bits = ops->measure(ops->context);
+    while (result.bits > budget && result.removed < max_removals) {
+        if (!ops->remove_highest(ops->context))
+            break;
+        result.removed++;
+        result.bits = ops->measure(ops->context);
+    }
+    return result;
+}
+#endif
