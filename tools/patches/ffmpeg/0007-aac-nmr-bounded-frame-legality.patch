+/* Encode silence with only mandatory syntax, retaining the window sequence
+ * so the decoder can overlap it with neighbouring frames. */
+static void nmr_silence_element(ChannelElement *cpe, int chans)
+{
+    cpe->common_window = 0;
+    cpe->ms_mode = 0;
+    cpe->is_mode = 0;
+    for (int ch = 0; ch < chans; ch++) {
+        SingleChannelElement *sce = &cpe->ch[ch];
+        memset(sce->zeroes, 1, sizeof(sce->zeroes));
+        memset(sce->band_type, 0, sizeof(sce->band_type));
+        sce->sf_idx[0] = av_clip(sce->sf_idx[0], 0, 255);
+    }
+    adjust_frame_information(cpe, chans);
+}
