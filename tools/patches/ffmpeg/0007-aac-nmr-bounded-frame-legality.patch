+typedef struct NMRBudgetContext {
+    AACEncContext *s;
+    NMRSlot *const *slots;
+    int count;
+    float lambda;
+    int cap;
+} NMRBudgetContext;
+
+static int nmr_budget_bits(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    int bits = 0;
+    for (int k = 0; k < c->count; k++) {
+        NMRSlot *t = c->slots[k];
+        bits += nmr_slot_bits(t, c->s->nmr->nb[t->si], NMR_STEP);
+        for (int b = 0; b < t->nbnd; b++)
+            bits += t->is_pns[b] ? NMR_PNS_BITS : 0;
+    }
+    return bits;
+}
+
+static void nmr_budget_coarsen(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    AACEncContext *s = c->s;
+    const int coarse_step = NMR_COARSE > 0 ? NMR_COARSE : 8;
+    int noise_bits = 0;
+    /* A fine grid centered on the preceding solve may contain no legal
+     * allocation, regardless of lambda. Re-open the complete coarse range
+     * first, then refine around that feasible operating point. */
+    for (int pass = 0; pass < 2; pass++) {
+        const int step = pass ? NMR_STEP : coarse_step;
+        for (int k = 0; k < c->count; k++) {
+            NMRSlot *t = c->slots[k];
+            s->aacdsp.abs_pow34(s->scoefs, t->sce->coeffs, 1024);
+            ff_quantize_band_cost_cache_init(s);
+            for (int b_ = 0; b_ < t->nact; b_++) {
+                int b = t->act[b_], bi = t->bidx[b];
+                int center = t->blo[b] + t->chosen[b] * coarse_step;
+                int floor = av_clip(t->minsf[bi], 0, SCALE_MAX_POS);
+                int lo = pass ? av_clip(center - coarse_step, floor, SCALE_MAX_POS) : floor;
+                int maxn = pass ? FFMIN(NMR_NCAND, 2*coarse_step + 1) : NMR_NCAND;
+                float invthr = 1.f / FFMAX(t->thr[bi], 1e-9f);
+                int nc = nmr_band_curve(s, t->sce, t->bw[b], t->bg[b], t->bst[b],
+                                        lo, step, maxn, invthr, t->maxvals[bi],
+                                        s->nmr->nd[t->si][b], s->nmr->nb[t->si][b]);
+                if (!nc) {
+                    s->nmr->nd[t->si][b][0] = 0.f;
+                    s->nmr->nb[t->si][b][0] = 0;
+                }
+                if (t->tnsg[bi] > 1.f)
+                    for (int o = 0; o < nc; o++)
+                        s->nmr->nd[t->si][b][o] *= t->tnsg[bi];
+                t->blo[b] = lo;
+                t->bnc[b] = FFMAX(1, nc);
+            }
+            if (!pass)
+                for (int b = 0; b < t->nbnd; b++)
+                    noise_bits += t->is_pns[b] ? NMR_PNS_BITS : 0;
+        }
+        c->lambda = nmr_solve_slots(s, c->slots, c->count, step,
+                                    FFMAX(c->cap - noise_bits, 0),
+                                    1e-9f, 1e4f, NMR_ITERS);
+    }
+}
+
+static int nmr_budget_remove_highest(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    NMRSlot *chosen = NULL;
+    int chosen_band = -1, chosen_active = -1, highest = -1;
+    for (int k = 0; k < c->count; k++) {
+        NMRSlot *t = c->slots[k];
+        /* Keep each spectral chain's anchor. */
+        for (int i = 1; i < t->nact; i++) {
+            int b = t->act[i];
+            int frequency = (t->bst[b] - t->bw[b]*128) * t->sce->ics.num_windows;
+            if (frequency > highest) {
+                chosen = t; chosen_band = b; chosen_active = i; highest = frequency;
+            }
+        }
+        for (int b = 0; b < t->nbnd; b++) {
+            int frequency = (t->bst[b] - t->bw[b]*128) * t->sce->ics.num_windows;
+            if (t->is_pns[b] && frequency > highest) {
+                chosen = t; chosen_band = b; chosen_active = -1; highest = frequency;
+            }
+        }
+    }
+    if (!chosen)
+        return 0;
+    if (chosen_active >= 0) {
+        memmove(&chosen->act[chosen_active], &chosen->act[chosen_active + 1],
+                (chosen->nact - chosen_active - 1) * sizeof(chosen->act[0]));
+        chosen->nact--;
+    }
+    chosen->is_pns[chosen_band] = 0;
+    for (int w = 0; w < chosen->sce->ics.group_len[chosen->bw[chosen_band]]; w++)
+        chosen->sce->zeroes[(chosen->bw[chosen_band] + w)*16 + chosen->bg[chosen_band]] = 1;
+    nmr_eval_slots(c->s, c->slots, c->count, NMR_STEP, c->lambda);
+    return 1;
 }

