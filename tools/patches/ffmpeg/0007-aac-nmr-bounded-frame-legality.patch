+/* Repair lambdas reach far past the solver's usual 1e4 rail: there every
+ * band's distortion term is negligible against one bit, so the grid's
+ * minimum-cost allocation is reachable. lam^2 must stay finite in nmr_solve. */
+#define NMR_LAM_REPAIR_MAX 1e18f
+
+/* Bisect lambda in log space so the pooled bits fit cap. Unlike
+ * nmr_solve_slots, return a lambda proven to fit (the last midpoint may not)
+ * and leave chosen[] at it; return the rail when nothing on this grid fits. */
+static float nmr_fit_slots(AACEncContext *s, NMRSlot *const *sl, int nsl, int step,
+                           int cap, float lo, float hi)
+{
+    lo = FFMAX(lo, 1e-9f);
+    if (nmr_eval_slots(s, sl, nsl, step, hi) > cap || lo >= hi)
+        return hi;
+    for (int it = 0; it < NMR_ITERS; it++) {
+        const float mid = expf(0.5f * (logf(lo) + logf(hi)));
+        if (nmr_eval_slots(s, sl, nsl, step, mid) > cap)
+            lo = mid;
+        else
+            hi = mid;
+    }
+    nmr_eval_slots(s, sl, nsl, step, hi);
+    return hi;
+}
+
+typedef struct NMRBudgetContext {
+    AACEncContext *s;
+    NMRSlot *const *slots;
+    int count;
+    float lambda;
+    int cap;
+} NMRBudgetContext;
+
+/* Trellis-counted bits only, like the rest of the coder: PNS signalling and
+ * section data ride in the measured side-information estimate. */
+static int nmr_budget_bits(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    int bits = 0;
+    for (int k = 0; k < c->count; k++)
+        bits += nmr_slot_bits(c->slots[k], c->s->nmr->nb[c->slots[k]->si], NMR_STEP);
+    return bits;
+}
+
+/* Least disruptive: keep the solve's own candidate window and only move
+ * lambda as far as the cap requires. */
+static void nmr_budget_fit_current(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    c->lambda = nmr_fit_slots(c->s, c->slots, c->count, NMR_STEP, c->cap,
+                              c->lambda, NMR_LAM_REPAIR_MAX);
+}
+
+/* The fine window around the preceding solve may hold no legal allocation at
+ * any lambda. Reopen the complete coarse range, fit it, then refine one
+ * coarse step around that pick and fit again. */
+static void nmr_budget_reopen(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    AACEncContext *s = c->s;
+    const int coarse_step = NMR_COARSE > 0 ? NMR_COARSE : 8;
+    for (int pass = 0; pass < 2; pass++) {
+        const int step = pass ? NMR_STEP : coarse_step;
+        for (int k = 0; k < c->count; k++) {
+            NMRSlot *t = c->slots[k];
+            s->aacdsp.abs_pow34(s->scoefs, t->sce->coeffs, 1024);
+            ff_quantize_band_cost_cache_init(s);
+            for (int b_ = 0; b_ < t->nact; b_++) {
+                int b = t->act[b_], bi = t->bidx[b];
+                int center = t->blo[b] + t->chosen[b] * coarse_step;
+                int floor = av_clip(t->minsf[bi], 0, SCALE_MAX_POS);
+                int lo = pass ? av_clip(center - coarse_step, floor, SCALE_MAX_POS) : floor;
+                int maxn = pass ? FFMIN(NMR_NCAND, 2*coarse_step + 1) : NMR_NCAND;
+                float invthr = 1.f / FFMAX(t->thr[bi], 1e-9f);
+                int nc = nmr_band_curve(s, t->sce, t->bw[b], t->bg[b], t->bst[b],
+                                        lo, step, maxn, invthr, t->maxvals[bi],
+                                        s->nmr->nd[t->si][b], s->nmr->nb[t->si][b]);
+                if (!nc) {
+                    s->nmr->nd[t->si][b][0] = 0.f;
+                    s->nmr->nb[t->si][b][0] = 0;
+                }
+                if (t->tnsg[bi] > 1.f)
+                    for (int o = 0; o < nc; o++)
+                        s->nmr->nd[t->si][b][o] *= t->tnsg[bi];
+                t->blo[b] = lo;
+                t->bnc[b] = FFMAX(1, nc);
+            }
+        }
+        c->lambda = nmr_fit_slots(s, c->slots, c->count, step, c->cap,
+                                  1e-9f, NMR_LAM_REPAIR_MAX);
+    }
+}
+
+/* Last resort, reached only when even the reopened grid's minimum cost does
+ * not fit: drop the highest-frequency coded band, keeping each chain anchor. */
+static int nmr_budget_remove_highest(void *opaque)
+{
+    NMRBudgetContext *c = opaque;
+    NMRSlot *chosen = NULL;
+    int chosen_active = -1, highest = -1;
+    for (int k = 0; k < c->count; k++) {
+        NMRSlot *t = c->slots[k];
+        for (int i = 1; i < t->nact; i++) {
+            int b = t->act[i];
+            int frequency = (t->bst[b] - t->bw[b]*128) * t->sce->ics.num_windows;
+            if (frequency > highest) {
+                chosen = t; chosen_active = i; highest = frequency;
+            }
+        }
+    }
+    if (!chosen)
+        return 0;
+    {
+        const int b = chosen->act[chosen_active];
+        memmove(&chosen->act[chosen_active], &chosen->act[chosen_active + 1],
+                (chosen->nact - chosen_active - 1) * sizeof(chosen->act[0]));
+        chosen->nact--;
+        for (int w = 0; w < chosen->sce->ics.group_len[chosen->bw[b]]; w++)
+            chosen->sce->zeroes[(chosen->bw[b] + w)*16 + chosen->bg[b]] = 1;
+    }
+    nmr_eval_slots(c->s, c->slots, c->count, NMR_STEP, c->lambda);
+    return 1;
 }

