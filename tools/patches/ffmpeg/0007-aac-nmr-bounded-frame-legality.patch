--- /dev/null
+++ b/libavcodec/aacenc_nmr_budget.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Copyright (c) 2026 aufkrawall
+ * Bounded AAC NMR legality policy. Callbacks own the codec's candidate/band
+ * state; this header owns the order of the repair steps and the outer-loop
+ * decision, so both can be tested without a codec.
+ */
+#ifndef AVCODEC_AACENC_NMR_BUDGET_H
+#define AVCODEC_AACENC_NMR_BUDGET_H
+
+typedef struct AACNMRBudgetOps {
+    void *context;
+    int  (*measure)(void *context);
+    /* Re-fit on the current candidate grid: the least disruptive repair. */
+    void (*fit_current)(void *context);
+    /* Re-fit on the reopened full quantizer range, up to its minimum cost. */
+    void (*reopen)(void *context);
+    /* Remove one coded band; 0 when nothing removable is left. */
+    int  (*remove_highest)(void *context);
+} AACNMRBudgetOps;
+
+typedef struct AACNMRBudgetResult {
+    int initial_bits;
+    int bits;
+    int refit;
+    int reopened;
+    int removed;
+} AACNMRBudgetResult;
+
+/* Every removal consumes a band, even if repairing its scalefactor edge costs
+ * extra bits. Bound work by the band's finite count, not by elapsed time. */
+static inline AACNMRBudgetResult ff_aac_nmr_fit_budget(const AACNMRBudgetOps *ops,
+                                                       int budget, int max_removals)
+{
+    AACNMRBudgetResult result = { 0 };
+    result.initial_bits = result.bits = ops->measure(ops->context);
+    if (result.bits <= budget)
+        return result;
+    ops->fit_current(ops->context);
+    result.refit = 1;
+    result.bits = ops->measure(ops->context);
+    if (result.bits > budget) {
+        ops->reopen(ops->context);
+        result.reopened = 1;
+        result.bits = ops->measure(ops->context);
+    }
+    while (result.bits > budget && result.removed < max_removals) {
+        if (!ops->remove_highest(ops->context))
+            break;
+        result.removed++;
+        result.bits = ops->measure(ops->context);
+    }
+    return result;
+}
+
+/* Encode passes per frame before the terminal fallback. Each retry shrinks
+ * every legality cap by at least 10%, so a handful of passes always suffice
+ * unless the codec state is broken. */
+#define AAC_NMR_MAX_PASSES 32
+
+enum AACNMRFrameAction {
+    AAC_NMR_FRAME_ACCEPT,
+    AAC_NMR_FRAME_RETRY,
+    AAC_NMR_FRAME_SILENCE,
+};
+
+/* Outer-loop decision after an encode pass. bits_max is the frame's hard
+ * bound (decoder buffer, or the strict per-frame rate). passes counts the
+ * completed passes of this frame. A retry scales lambda by *lambda_scale; a
+ * silent frame stays decodable and keeps the frame's samples and timestamp. */
+static inline enum AACNMRFrameAction ff_aac_nmr_frame_action(int frame_bits, int bits_max,
+                                                             int passes, float *lambda_scale)
+{
+    float scale;
+    if (frame_bits <= bits_max)
+        return AAC_NMR_FRAME_ACCEPT;
+    if (passes >= AAC_NMR_MAX_PASSES)
+        return AAC_NMR_FRAME_SILENCE;
+    scale = bits_max > 0 ? (float)bits_max / (float)frame_bits : 0.0f;
+    *lambda_scale = scale < 0.9f ? scale : 0.9f;
+    return AAC_NMR_FRAME_RETRY;
+}
+#endif
