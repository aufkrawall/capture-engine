      "reason": "Existing cross-subsystem graphics implementation header; retire when its ownership interface replaces direct access.",
      "milestone": "Graphics D2/D12"
    },
    {
      "source": "hook/runtime/main_fatal_dump.cpp",
      "target": "hook/d3d12/dx12_hook_internal.h",
      "reason": "Existing cross-subsystem graphics implementation header; retire when its ownership interface replaces direct access.",
      "milestone": "Graphics D2/D12"
    },
    {
      "source": "hook/wrappers/dxgi_swapchain_wrap_attribution.cpp",
      "target": "hook/present/dxgi_shared_internal.h",
      "reason": "Existing cross-subsystem graphics implementation header; retire when its ownership interface replaces direct access.",
      "milestone": "Graphics D2/D12"
    },
    {
      "source": "hook/wrappers/dxgi_swapchain_wrap_diagnostics.cpp",
      "target": "hook/present/dxgi_shared_internal.h",
      "reason": "Existing cross-subsystem graphics implementation header; retire when its ownership interface replaces direct access.",
      "milestone": "Graphics D2/D12"
