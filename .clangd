# Capture Project Clangd Configuration
CompileFlags:
  # Allow clangd to query the actual compilers used in compile_commands.json to find system headers
  Compiler: [clang++, clang, clang-cl, cl]
  
  # Explicitly allow querying the MSYS2 clang drivers. 
  # This is CRITICAL for finding standard library headers on Windows for MinGW builds.
  QueryDriver: [
    "%REPO_ROOT%/build/msys64/clang64/bin/clang++",
    "%REPO_ROOT%/build/msys64/clang64/bin/clang",
    "%REPO_ROOT%/build/msys64/mingw32/bin/clang++",
    "%REPO_ROOT%/build/msys64/mingw32/bin/clang",
    "%REPO_ROOT%/build/msys64/clang64/bin/clang++.exe",
    "%REPO_ROOT%/build/msys64/clang64/bin/clang.exe",
    "%REPO_ROOT%/build/msys64/mingw32/bin/clang++.exe",
    "%REPO_ROOT%/build/msys64/mingw32/bin/clang.exe"
  ]
  
  # Flags in 'Add' are appended to every command in compile_commands.json.
  # We avoid adding target-specific flags here (like --target or -std) because
  # this project mixes MinGW (Clang) and MSVC (cl.exe) commands.
  # compile_commands.json should contain all necessary flags.
  CompilationDatabase: "."

Index:
  Background: true
  External: 
    File: .clangd_index

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Suppress: [
    "function_style_cast_to_builtin", # Suppress mmintrin.h error if it persists
    "drv_unknown_argument"
  ]
  ClangTidy:
    Add: [bugprone-*, performance-*, readability-*]
    Remove: [readability-braces-around-statements, readability-identifier-length]

Hover:
  ShowAKA: true

Completion:
  AllScopes: true
