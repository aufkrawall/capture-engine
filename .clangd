# Clangd configuration for CaptureEngine
# 
# This project builds both x64 and x86 targets.
# compile_commands.json contains x64 entries (preferred for LSP).
# 
# SETUP:
# - Windows: clangd from MSYS2 clang64 environment:
#   pacman -S mingw-w64-clang-x86_64-clang-tools-extra
#
# NOTE: The Compiler, resource-dir and isystem paths below point into the
# MSYS2 clang64 toolchain that build.py installs under build/msys64.
# They use a path relative to the project root so they work on any machine.
# If clangd cannot resolve the relative path, set the MSYS2_ROOT environment
# variable or replace the paths with absolute paths for your machine.

# clangd automatically looks for compile_commands.json in parent directories

# Use the MinGW toolchain explicitly (not MSVC)
# This prevents clangd from falling back to MSVC headers
Clangd:
  Tidy: true

# Provide explicit configuration for system includes
# clangd needs these because it doesn't inherit the compiler's implicit paths
CompileFlags:
  Compiler: build/msys64/clang64/bin/clang++.exe
  Add:
    # Resource directory (clang intrinsics)
    - "-resource-dir=build/msys64/clang64/lib/clang/21"
    # C++ standard library
    - "-isystem"
    - "build/msys64/clang64/include/c++/v1"
    # Windows SDK and other system headers
    - "-isystem"
    - "build/msys64/clang64/include"
  Remove:
    # Flags clangd doesn't understand or that cause spurious errors
    - "-march=*"
    - "-mtune=*"
    - "-flto*"
    - "-ffast-math"
    - "-fvisibility=*"
    - "-ffunction-sections"
    - "-fdata-sections"
    - "-Wl,*"
    - "-s"
    - "-MMD"
    - "-MF"
    - "-Wno-microsoft-exception-spec"

Diagnostics:
  Suppress:
    - "unused-parameter"
    - "gnu-zero-variadic-macro-arguments"
    - "microsoft-exception-spec"
  ClangTidy:
    Add:
      - "modernize-use-nullptr"
      - "modernize-use-override"
      - "modernize-use-default-member-init"
      - "readability-const-return-type"
      - "bugprone-use-after-move"

Index:
  Background: Build

InlayHints:
  Designators: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true