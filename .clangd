# Clangd configuration for CaptureEngine
# 
# WORKS IN BOTH ENVIRONMENTS:
# - WSL2: Uses compile_commands.json directly
# - Windows (MSYS2 clang64): Uses PathMappings to translate WSL paths
#
# SETUP:
# - WSL2: clangd from system (apt install clangd)
# - Windows: clangd from MSYS2 clang64 environment:
#   pacman -S mingw-w64-clang-x86_64-clang-tools-extra

# Path mappings for Windows LSP reading WSL-generated compile_commands.json
PathMappings:
  "/mnt/c/": "C:/"
  "/mnt/d/": "D:/"

# Use compile_commands.json generated by build.py
CompilationDatabase: .

# Additional flags for cross-compilation headers
# These supplement compile_commands.json when clangd needs extra context
CompileFlags:
  Add:
    - "--target=x86_64-w64-mingw32-gnu"
    # GCC cross-compilation system includes (clangd auto-detects version)
    - "-isystem/usr/x86_64-w64-mingw32/include"
    - "-isystem/usr/x86_64-w64-mingw32/include/c++"
    - "-isystem/usr/x86_64-w64-mingw32/include/c++/x86_64-w64-mingw32"
  Remove:
    # Flags clangd doesn't understand
    - "-march=*"
    - "-mtune=*"
    - "-flto*"
    - "-ffast-math"
    - "-fvisibility=*"
    - "-ffunction-sections"
    - "-fdata-sections"
    - "-Wl,*"
    - "-s"
    - "-MMD"
    - "-MF"
    - "-Wno-microsoft-exception-spec"

Diagnostics:
  Suppress:
    - "unused-parameter"
    - "gnu-zero-variadic-macro-arguments"
    - "microsoft-exception-spec"
  ClangTidy:
    Add:
      - "modernize-use-nullptr"
      - "modernize-use-override"

Index:
  Background: Build

InlayHints:
  Designators: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true
