# Clangd configuration for CaptureEngine
# Works automatically in both Windows and WSL2 environments

CompileFlags:
  Add:
    - "-std=c++20"
    - "-D_WIN32_WINNT=0x0A00"
    - "-DWIN32"
    - "-D_WINDOWS"
    - "-D__MINGW64__"
    - "--target=x86_64-w64-mingw32-gnu"
    # Project include paths (relative, work in both Windows and WSL)
    - "-Icommon"
    - "-Ihook"
    - "-Ihook/common"
    - "-Ihook/apis"
    - "-Ihook/wrappers"
    - "-Ihook/vulkan_layer"
    - "-Icaptureengine"
    - "-Imediaengine"
    - "-Iexternal/ffmpeg/include"
    # System headers for mingw-w64 cross-compilation
    - "-isystem/usr/x86_64-w64-mingw32/include"
    - "-isystem/usr/x86_64-w64-mingw32/include/c++"
    - "-isystem/usr/x86_64-w64-mingw32/include/c++/x86_64-w64-mingw32"
  Remove:
    # Flags clangd doesn't understand or that cause issues
    - "-march=*"
    - "-mtune=*"
    - "-flto*"
    - "-ffast-math"
    - "-fvisibility=*"
    - "-ffunction-sections"
    - "-fdata-sections"
    - "-Wl,*"
    - "-s"
    - "-MMD"
    - "-MF"

Diagnostics:
  # Only suppress truly noisy warnings in cross-platform code
  Suppress:
    - "unused-parameter"
    - "gnu-zero-variadic-macro-arguments"
  ClangTidy:
    Add:
      - "modernize-use-nullptr"
      - "modernize-use-override"

Index:
  Background: Build

InlayHints:
  Designators: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true
