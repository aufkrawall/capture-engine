# Clangd configuration for CaptureEngine
# 
# WORKS IN BOTH ENVIRONMENTS:
# - WSL2: Uses compile_commands.json directly
# - Windows (MSYS2 clang64): Uses PathMappings to translate WSL paths
#
# SETUP:
# - WSL2: clangd from system (apt install clangd)
# - Windows: clangd from MSYS2 clang64 environment:
#   pacman -S mingw-w64-clang-x86_64-clang-tools-extra

# Path mappings for Windows LSP reading WSL-generated compile_commands.json
PathMappings:
  "/mnt/c/": "C:/"
  "/mnt/d/": "D:/"

# Use compile_commands.json generated by build.py
CompilationDatabase: .

# Additional flags for cross-compilation headers
CompileFlags:
  Add:
    - "--target=x86_64-w64-mingw32-gnu"
    # Provide a safe march for builtins (SSE4.2+POPCNT) without requiring AVX2.
    # Compile_commands.json carries the real -march; this ensures clangd resolves
    # architecture-specific builtins like _mm_pause, __builtin_ia32_*.
    - "-march=x86-64-v2"
  Remove:
    # Flags clangd doesn't understand or that cause spurious errors
    - "-march=x86-64-v3"
    - "-mtune=*"
    - "-flto*"
    - "-ffast-math"
    - "-fvisibility=*"
    - "-ffunction-sections"
    - "-fdata-sections"
    - "-Wl,*"
    - "-s"
    - "-MMD"
    - "-MF"
    - "-Wno-microsoft-exception-spec"

Diagnostics:
  Suppress:
    - "unused-parameter"
    - "gnu-zero-variadic-macro-arguments"
    - "microsoft-exception-spec"
  ClangTidy:
    Add:
      - "modernize-use-nullptr"
      - "modernize-use-override"
      - "modernize-use-default-member-init"
      - "readability-const-return-type"
      - "bugprone-use-after-move"

Index:
  Background: Build

InlayHints:
  Designators: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true
