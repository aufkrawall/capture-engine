# Clangd configuration for CaptureEngine
# 
# NOTE: When using WSL2 with mingw-w64 GCC cross-compilation, clangd may show
# false-positive errors (cstdlib/stdlib.h issues). This is a known limitation.
# The code compiles successfully - these are IDE-only errors.
#
# For best LSP experience on Windows:
#   pacman -S mingw-w64-clang-x86_64-clang-tools-extra
# Then use clangd from MSYS2's clang64 environment.

# Path mappings for WSL2 -> Windows translation (when running clangd on Windows)
PathMappings:
  "/mnt/c/": "C:/"
  "/mnt/d/": "D:/"

# Use compile_commands.json generated by build.py
CompilationDatabase: .

# Additional flags for clangd to find cross-compilation headers
CompileFlags:
  Add:
    - "--target=x86_64-w64-mingw32-gnu"
    # GCC cross-compilation system includes
    - "-isystem/usr/x86_64-w64-mingw32/include/c++/15.2.0"
    - "-isystem/usr/x86_64-w64-mingw32/include/c++/15.2.0/x86_64-w64-mingw32"
    - "-isystem/usr/x86_64-w64-mingw32/include"
    # MSYS2 clang64 headers
    - "-isystem%REPO_ROOT%/build/msys64/clang64/include"
  Remove:
    - "-march=*"
    - "-mtune=*"
    - "-flto*"
    - "-ffast-math"
    - "-fvisibility=*"
    - "-ffunction-sections"
    - "-fdata-sections"
    - "-Wl,*"
    - "-s"
    - "-MMD"
    - "-MF"
    - "-Wno-microsoft-exception-spec"

Diagnostics:
  Suppress:
    - "unused-parameter"
    - "gnu-zero-variadic-macro-arguments"
    - "microsoft-exception-spec"
  ClangTidy:
    Add:
      - "modernize-use-nullptr"
      - "modernize-use-override"

Index:
  Background: Build

InlayHints:
  Designators: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true