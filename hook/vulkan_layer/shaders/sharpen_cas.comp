#version 450
#extension GL_GOOGLE_include_directive : require

// Compute variant of sharpen_cas.frag for compute-only present queues. Same
// kernel, same constants, same resolve; it writes the presentable image as a
// storage image instead of a colour attachment.

#define FFX_GPU 1
#define FFX_GLSL 1
#define FFX_HALF 0
#define CE_SHARPEN_COMPUTE 1

#include "ffx_core.h"
#include "sharpen_common.glsl"

// ffx_cas.h calls these directly and declares no prototypes, so they have to be
// defined before it is included.
FfxFloat32x3 casLoad(FfxInt32x2 position) {
    return ceLoadSource(position).rgb;
}

void casInput(inout FfxFloat32 red, inout FfxFloat32 green, inout FfxFloat32 blue) {
    ceToFilterSpace(red, green, blue);
}

#include "cas/ffx_cas.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    FfxInt32x2 position = FfxInt32x2(gl_GlobalInvocationID.xy);
    if (any(greaterThan(position, ceConstants.ceMaxCoord))) {
        return;
    }
    FfxUInt32x2 gxy = FfxUInt32x2(position);
    FfxFloat32x4 original = ceLoadSource(position);
    FfxFloat32x3 filtered;
    // noScaling: the constants were built with identical input and output extents.
    ffxCasFilter(filtered.r, filtered.g, filtered.b, gxy, ceConstants.ceConst0, ceConstants.ceConst1, true);
    imageStore(ceTarget, position, ceResolveOutput(filtered, original));
}
