---
# Minimal clang-tidy configuration for CaptureEngine.
# Run automatically as part of `python build.py --lint` (and default mode).
# Uses compile_commands.json — does NOT recompile.

Checks: >
  bugprone-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-enum-size,
  -performance-avoid-endl,
  -performance-no-int-to-ptr

CheckOptions:
  - key:   bugprone-argument-comment.StrictMode
    value: '0'

# Analyze project headers, but do not report diagnostics from vendored or
# generated/runtime trees. Those sources are not maintained by this project.
HeaderFilterRegex: '(^|/)(common|hook|captureengine|mediaengine|testapp|tests)/'
ExcludeHeaderFilterRegex: '(^|/)(external|build|installed|ffmpeg_build)/'
FormatStyle: file
