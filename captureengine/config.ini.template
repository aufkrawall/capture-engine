; =============================================================================
; CaptureEngine Configuration
; =============================================================================
; CaptureEngine creates this file when config.ini is missing. It does not replace
; an existing file. Lines beginning with ';' are comments.
; Changes are reloaded automatically. Settings used to start a recording take
; effect the next time recording starts.

; =============================================================================
; BASIC SETTINGS
; =============================================================================

[Capture]
; Choose how video is captured: auto, inject, wgc, or dxgi_dup.
; auto follows the application profiles at the end of this file. Applications
; allowed to use injected capture use it; other windows use WGC, with the
; fullscreen fallback selected below.
; inject captures through the injected DLL.
; wgc captures a window or monitor with Windows Graphics Capture.
; dxgi_dup captures a monitor with DXGI Desktop Duplication.
capture_method=auto

; Monitor used by monitor-scope WGC and DXGI Duplication capture.
; auto uses the target application's window, then an eligible foreground window,
; then the Windows primary monitor. primary always uses the Windows main display.
; window requires a matched target window. cursor uses the monitor containing the
; pointer when recording starts. id:<stable-id> selects one exact physical display;
; run CaptureEngine.exe --list-monitors to list copyable IDs. An explicit selector
; never silently redirects recording to a different monitor.
monitor=auto

; Best-effort privacy mask for WGC and DXGI Duplication. When true, video is
; opaque black (including cursor and overlays) unless the selected window is
; focused and fullscreen-like, or a fullscreen-like foreground window occupies
; the selected monitor. Windows focus/bounds detection is not 100% reliable, so
; this is not a guaranteed privacy or redaction boundary. The check uses passive
; window-state APIs only; it does not inspect or inject into the captured app.
; It does not make injection anti-cheat-safe or claim universal approval; use a
; WGC/DXGI profile with dll_injection=never when injection must be excluded.
black_when_no_fullscreen_focus=false

; Fullscreen fallback used by auto: dxgi_dup or wgc_window.
auto_fullscreen_capture=dxgi_dup

[WGC]
; Windows limitation: a WGC capture session can make Windows switch to a
; software-rendered (DWM-composed) mouse cursor instead of the hardware
; cursor. This is independent of capture_cursor and of CaptureEngine's
; encoder-side cursor composition. DXGI Desktop Duplication
; (capture_method=dxgi_dup) is not affected and preserves the separate
; hardware cursor plane.
; Keep frame delivery even while CaptureEngine is delaying video to match audio.
wgc_active_delay_uniform_cadence=true

; This buffer absorbs short WGC delivery gaps. The size and VRAM limit are upper
; bounds; CaptureEngine does not reserve the full amount up front.
wgc_smoothness_buffer_enabled=true
wgc_smoothness_buffer_max_ms=300
wgc_smoothness_buffer_vram_budget_mb=3000
; auto learns a useful minimum at startup. 0 disables the minimum. You can also
; enter a number of milliseconds up to wgc_smoothness_buffer_max_ms.
wgc_smoothness_floor_ms=auto

; Leave this false to preserve HDR and other sources above 8-bit. true permits a
; smaller 8-bit pool when an R10 pool is unavailable. bit_depth=10 still requires
; a 10-bit or FP16 source.
wgc_allow_lossy_bgra8_pool=false
; Same-device capture usually has the lowest overhead. false uses a dedicated
; capture device and the split-device handoff (diagnostic fallback path).
wgc_same_device_capture=true

[Output]
; Empty paths use the captures folder next to CaptureEngine.exe. Relative paths
; start from the CaptureEngine installation folder.
; output_dir and screenshot_dir are independent. Set both to use the same custom
; folder for recordings and screenshots.
output_dir=
screenshot_dir=
; mkv, mp4, or mov. Only MKV is actively tested. MKV is also the safest choice
; if recording is interrupted.
container=mkv

[Streaming]
; Stream-only mode for YouTube, Twitch, or a custom RTMP service. It is disabled
; by default. When enabled, the normal recording hotkey starts/stops the stream;
; no local video file is written at the same time. Audio-only capture remains a
; local MKA recording.
enabled=false
; youtube, twitch, or custom. The service selects conservative bitrate defaults.
service=twitch
; Copy the ingest server from the service's encoder setup page. Include its app
; path, for example rtmps://ingest.example/app. RTMPS is preferred when offered.
server=
; Treat this like a password. It is stored in this config file, but CaptureEngine
; redacts the destination and key from its logs.
stream_key=
; Optional complete rtmp:// or rtmps:// publishing URL. When set, this overrides
; server and stream_key.
url=
; Kbps. 0 selects 12000/128 for YouTube and 6000/160 for Twitch/custom.
video_bitrate=0
audio_bitrate=0
; Live output is capped at 60 fps. A lower [Video] fps remains unchanged.
max_fps=60
; 0 gives the lowest encode latency; 1-2 trades some latency for compression.
b_frames=0
; Streaming preserves the selected hardware backend but uses its H.264 encoder,
; CBR, a two-second keyframe interval, 8-bit BT.709 4:2:0, and low-latency
; backend settings. All enabled audio sources are mixed through the existing
; synchronized timeline into one 48 kHz stereo AAC track.

[Screenshot]
; auto saves an HDR source as a native 10-bit BT.2020/PQ AVIF and an SDR source
; as PNG. bt709 always saves PNG and tone-maps HDR using the Windows SDR white
; level, matching forced-SDR video capture.
color_space=auto

[Video]
; Choose an encoder supported by your GPU. CaptureEngine does not silently switch
; to another encoder. Examples: av1_nvenc, av1_amf, hevc_qsv, av1_mf, h264_mf.
encoder=av1_nvenc
; Output frame rate, from 1 to 1000. Recordings use a constant frame rate.
fps=120
; VBR, CBR, CQ, or CQP. AMF and Quick Sync use their own qp setting below.
; Quick Sync CQ uses QVBR when bitrate and max_bitrate are set, or ICQ when
; bitrate is empty.
rate_control=VBR
bitrate=125Mbps
max_bitrate=200Mbps
; Optional VBV/HRD buffer size such as 250Mbps. Empty lets the encoder choose.
buffer_size=
; Seconds between keyframes. 0 lets the encoder choose.
keyframe_interval=2
; auto, or an encoder profile such as main, high, high10, main10, or rext.
profile=auto
; 0-4.
b_frames=0
; Extra FFmpeg options in key=value:key=value form. Empty means none.
custom_options=
capture_cursor=true
; auto preserves an HDR source as 10-bit and uses 8-bit for ordinary SDR.
; Explicit 10-bit needs a compatible source and encoder.
bit_depth=auto
; auto follows the captured source. bt709 forces SDR and tone-maps HDR input;
; bt2020 preserves HDR input as BT.2020/PQ. On an SDR source it selects SDR
; BT.2020; it does not falsely relabel SDR pixels as PQ.
color_space=auto
; auto, full, or limited.
color_range=limited
; auto or 420. 422 and 444 are not supported yet.
chroma_subsampling=auto
; Nominal HDR mastering/content-light ceiling in nits (100-10000). Screen
; capture has no measured mastering metadata after desktop composition, so this
; compatibility value is written consistently to the encoder and container.
hdr_nominal_peak_nits=1000

[NVENC]
; p1 is fastest; p7 spends the most time on quality.
preset=p1
; hq, ll, ull, or lossless.
tuning=hq
; Per-frame multipass:
; auto - selects qres for CBR or when b_frames>0; otherwise it selects disabled.
; qres, fullres - manually choose between quarter and full res multipass.
; disabled - guarantees single-pass and the least encoder work.
multipass=disabled
; HEVC/AV1 split encoding shares each frame across physical NVENC engines but
; still produces one stream.
; 0 disables it.
; 1 requests splitting when multiple engines exist and lets the driver choose the strip count.
; 2, 3, or 4 request that many strips when available.
split_encode=0
; Lower values mean higher quality. H.264/HEVC use 0-51. AV1 CQ uses 0-63.
qp=23
; lookahead is not a true/false switch:
; off guarantees lookahead is disabled.
; auto enables a 20-frame depth;
; or enter a value between 1-31 (capped at 31-b_frames).
lookahead=off
; Spatial AQ spends more bits on detailed parts of each frame. OBS combines this
; and temporal_aq in its single "Adaptive Quantization" switch.
spatial_aq=false
; Temporal AQ shifts bits between frames based on motion.
temporal_aq=false
; Spatial AQ strength: 0 lets NVENC choose; 1-15 ranges from weak to aggressive.
; This has no effect while spatial_aq=false. For an OBS-like enabled setting,
; set both AQ switches to true and use aq_strength=8.
aq_strength=8
; B-Frame as Reference:
; auto - chooses middle when b_frames>0 and the GPU supports it; otherwise it chooses disabled.
; disabled - guarantees off;
; each or middle forces that mode and may fail if unsupported. This has no effect
; while b_frames=0. Leave auto normally; each can be costly with many B-frames.
b_ref_mode=disabled

[AMF]
; Used by h264_amf, hevc_amf, and av1_amf. The AMF runtime comes from the AMD
; display driver; frames remain GPU-resident on the capture D3D11 device.
; In addition to the common modes, [Video] rate_control accepts QVBR, HQVBR,
; HQCBR, and VBR_LATENCY. CQ is the convenient QVBR alias.
; transcoding, ultralowlatency, lowlatency, webcam, high_quality, or
; lowlatency_high_quality.
usage=transcoding
; speed, balanced, quality, or high_quality.
preset=balanced
; Lower is higher quality. CQ uses 0-51. CQP uses 0-51 for H.264/HEVC and
; 0-255 for AV1.
qp=23
; 1-42. Higher values allow more parallel work but add latency and surfaces.
async_depth=16
; Assisted rate control. These may improve compression but cost GPU time.
preencode=false
preanalysis=false
; off, auto (20 frames), or 1-41. Lookahead enables preanalysis automatically.
lookahead=off
; Spatial AQ maps to VBAQ/CAQ. Temporal AQ uses AMF preanalysis.
spatial_aq=false
temporal_aq=false
; Preanalysis CAQ strength: 0=low, 1=medium, 2=high.
aq_strength=1
high_motion_quality_boost=false
; auto, disabled, or enabled. H.264 only and meaningful with B-frames.
; H.264/AV1 support up to 3 B-frames; HEVC AMF currently exposes none.
b_ref_mode=auto
; Useful for strict streaming targets; normally leave both false for recording.
enforce_hrd=false
filler_data=false

[QuickSync]
; Used by h264_qsv, hevc_qsv, and av1_qsv through the bundled oneVPL dispatcher.
; The encoder is derived from the capture D3D11 device and uses direct QSV
; surface mapping, so no VAAPI layer or CPU frame transfer is involved.
; [Video] rate_control also accepts QVBR and ICQ. CQ selects QVBR when both
; bitrate fields are present and ICQ when bitrate is empty.
; veryfast, faster, fast, medium, slow, slower, or veryslow.
preset=veryfast
; Lower is higher quality. CQ/ICQ uses 1-51. CQP allows 0-51, or 0-255 for AV1.
qp=23
; Maximum in-flight processing depth. The oneVPL/FFmpeg default is 4.
async_depth=4
; auto, disabled, or enabled. Low-power mode may restrict other features.
low_power=auto
; off, auto (20 frames), or 1-100. H.264 uses native LA/LA_ICQ; HEVC/AV1 use
; oneVPL ExtBRC lookahead. Lookahead is not compatible with CBR or CQP.
lookahead=off
; MB-level bitrate control (H.264/HEVC), extended BRC, and adaptive frame
; placement. Each accepts auto, disabled, or enabled.
mbbrc=auto
extbrc=auto
adaptive_i=auto
adaptive_b=auto
low_delay_brc=auto
; unknown, displayremoting, videoconference, archive, livestreaming,
; cameracapture, videosurveillance, gamestreaming, or remotegaming.
; AV1 currently ignores this oneVPL hint.
scenario=unknown

[MediaFoundation]
; Used by encoders ending in _mf.
; default, cbr, pc_vbr, u_vbr, quality, ld_vbr, g_vbr, or gld_vbr.
rate_control=pc_vbr
; Quality target from 0 to 100. Higher values favor image quality.
quality=80
; camera_record requests CFR behavior from the MFT and is the recording default.
; Other values: default, live_streaming, archive, or video_conference.
scenario=live_streaming
; true requests hardware encoding. false allows software encoding instead.
hw_encoding=true
; -1 uses the MFT default. 0-100 is passed as its quality-vs-speed policy.
quality_vs_speed=-1
; Low latency disables B-frames. Leave false for normal recordings.
low_latency=false

[VideoScaling]
enabled=false
; native, 720p, 1080p, 1440p, 4k, or a size such as 1920x1080.
output_resolution=1080p
; normal or best.
quality=best
; 0-100. Reduce this if edges look too sharp.
sharpness=100

[Audio]
; These are the shared encoding defaults for system audio, microphones, and app
; audio. Individual sources can override them.
; aac, alac, flac, opus, or pcm.
codec=aac
; Kbps. Lossless codecs ignore this value.
bitrate=320
; default uses 48000 Hz. You can also enter a positive sample rate such as 44100,
; 48000, or 96000. Opus always uses 48000 Hz.
sample_rate=default
; default uses 24-bit audio for ALAC, FLAC, and PCM. AAC and Opus ignore this
; setting.
bit_depth=default
; false keeps the source's channel layout. true converts the output to stereo.
downmix=false

[SystemAudio]
; Records the default Windows output device. Set device to a Windows device name
; to use a specific output instead.
enabled=true
device=
; Track IDs are 1-255. A list sends this source to more than one track. Sources
; with the same ID are mixed together.
track=1
; Usually omit this. See [AudioSync] before changing it.
;capture_latency_ms=0

; [SystemAudio.1] through [SystemAudio.8] add more output devices. Their encoding
; settings come from [Audio] unless overridden. codec, bitrate, sample_rate,
; bit_depth, and downmix can also be set in any source section.
;[SystemAudio.1]
;enabled=true
;device=Speakers (Realtek)
;track=11
;capture_latency_ms=0

[Microphone]
; Disabled by default so a new installation never records a microphone by surprise.
enabled=false
device=
track=2
; Usually omit this. See [AudioSync] before changing it.
;capture_latency_ms=0

; [Microphone.1] through [Microphone.8] add more input devices. Microphone source
; sections can override the same encoding settings as system-audio sources.
;[Microphone.1]
;enabled=true
;device=Microphone (USB)
;track=21
;capture_latency_ms=0

[Hotkeys]
; Combinations such as Ctrl+Shift+F10 are supported. Empty disables a hotkey,
; except start_stop, which falls back to F9 so recording always has a toggle.
start_stop=CTRL+9
; Toggles the in-game overlay on/off at runtime (no restart required).
toggle_overlay=CTRL+8
screenshot=CTRL+0
; Starts or stops a recording that contains audio but no video.
audio_only=CTRL+Minus

[Overlay]
; This is the overlay drawn inside injected applications.
enabled=true
; Include that overlay in recordings and screenshots, respectively.
capture_include_overlay=true
screenshot_include_overlay=true
; TopLeft, TopRight, BottomLeft, or BottomRight.
position=TopLeft
; 0-4096 pixels.
padding=10
show_fps=true
; Shows the frame-time graph.
show_frametime=true
; display_change measures when visible screen content changes and includes
; generated frames and variable-refresh timing. presentation measures calls
; made by the application. The display-change source falls back automatically
; while system timing data is unavailable.
frametime_source=display_change
show_cpu=true
show_gpu=true
show_ram=true
show_vram=true
show_recording=true
; Shows whether supported frame generation is active.
show_fg=true
; compact_mode reduces spacing. horizontal_mode puts metrics in a row instead of
; a vertical list.
compact_mode=false
horizontal_mode=false
; 0 chooses the size automatically.
font_size=0
; Corner radius in pixels. 0 makes square corners.
rounded_corners=8
; Milliseconds. 0 updates text every rendered frame.
text_update_interval=500

; Colors use six RGB hex digits. A leading # is optional. bg_alpha uses 0 for a
; transparent background and 1 for an opaque one.
bg_color=000000
bg_alpha=0.50
fps_color=B8FA05
cpu_color=2E9762
gpu_color=2E9762
ram_color=C26693
vram_color=AD5F26
frametime_color=00FF00
text_color=FFFFFF
text_outline=true
text_outline_color=000000
; Outline thickness from 0 to 32 pixels.
text_outline_thickness=1.5
load_color_low=2E9762
load_color_med=FFCF00
load_color_high=FF0000
; auto matches the Windows SDR-white calibration of the game's current monitor.
; Otherwise enter an explicit 1-10000 nit overlay paper white.
hdr_paper_white=auto

[HardwareSensors]
; Optional LibreHardwareMonitor bridge for CPU/GPU temperature, package power,
; and GPU fan RPM. A contained child owned by the dedicated sensor service loads
; it, never the injected game process. auto uses it when all required plugin
; files exist; on additionally warns when they are missing; off disables it.
enabled=auto
; Polling interval in milliseconds (250-10000).
poll_interval_ms=1000
; Each value is off, auto, or an exact LibreHardwareMonitor identifier such as
; /gpu-nvidia/0/temperature/0. Auto GPU selection follows the GPU with the
; highest reported GPU Core load. Values are appended to the existing CPU/GPU
; overlay rows, so [Overlay] show_cpu/show_gpu remain the display toggles.
cpu_temperature=auto
gpu_temperature=auto
cpu_package_power=off
gpu_package_power=off
gpu_fan=off

[DesktopOverlay]
; This small screen-corner window works without injection and is useful with WGC
; or DXGI capture.
; mode 0 shows a recording indicator.
; mode 1 also shows a NOT RECORDING warning.
; mode 2 shows only the warning.
enabled=true
; Indicator size is 10-200 pixels. pad is its distance from the screen edges,
; from 0 to 100 pixels.
size=20
pad=20
; 0=BottomRight, 1=BottomLeft, 2=TopRight, 3=TopLeft.
pos=0
mode=2
; always_render keeps a nearly invisible window present even when there is no
; indicator to show. It can help in a few window/VRR cases, but normally stays
; false. always_render_only_when_game limits that keepalive to warning targets and
; has no effect unless always_render is true.
always_render=false
always_render_only_when_game=false
; Shows live encoder-capacity, recovery, and video-degraded recording warnings.
show_encoder_overload_warnings=true
; After focus changes, wait this many milliseconds for the intended window before
; deciding whether to show NOT RECORDING. Valid range: 0-10000.
foreground_acquire_grace_ms=2000
; Profiles that have both process and a video route trigger the NOT RECORDING
; warning automatically. The legacy process_list fallback is only needed for
; processes without a profile — and can be removed from new configs entirely.

[FpsLimiter]
; Capture sync limits an injected application to a multiple of the recording frame
; rate while recording.
capture_sync_enabled=false
; 1-8. For example, 2 limits a game to 120 fps while recording at 60 fps.
capture_sync_multiplier=2
; auto, basic, fg_fallback, or reflex.
capture_sync_limiter_mode=basic
; The general limiter applies whenever CaptureEngine is injected, including while
; no recording is running.
general_enabled=false
; General limit from 1 to 1000 fps.
general_fps=60
; Accepts the same modes as capture_sync_limiter_mode.
general_limiter_mode=basic

; =============================================================================
; ADVANCED SETTINGS
; =============================================================================

[Graphics]
; These settings affect injected applications only. default leaves the
; application's setting alone.
; vsync_mode: default, off, fifo, adaptive, or mailbox. fifo is normal V-Sync.
vsync_mode=default
; anisotropic_filtering: default, off, 2x, 4x, 8x, or 16x.
anisotropic_filtering=default
; safe avoids special-purpose samplers. aggressive changes more samplers.
sampler_override_mode=safe
; mip_mapping: default, nearest, bilinear, or trilinear.
mip_mapping=default
; mip_bias is default or a number from -16 to 15.99. Negative values sharpen
; distant textures. strict replaces the application's bias, offset adds to it,
; and base adjusts only negative application bias.
mip_bias=default
mip_bias_mode=strict
; true forces mip bias to zero and takes precedence over the two settings above.
force_mip_bias_clamp=false
; on fixes NVIDIA's long-standing texture filtering quality bug with negative LOD
; bias in OpenGL and Vulkan, by forcing the driver's FERMI_UNOPT_LOD_SPREAD setting
; ON. NVIDIA defaults it to off, which drops the LOD spread to zero. The Vulkan
; layer applies it after instance creation and before device creation, so
; DXVK/native Vulkan cannot initialize first. NVIDIA cards only; ignored everywhere
; else.
; Note that patching a graphics driver in memory - even read-only for other
; processes - is the kind of thing some anti-cheat systems object to, so leave this
; off for competitive online games.
nv_lod_spread_fix=off
; -1 leaves the application alone. Other valid values are 0-6.
cpu_prerender_limit=-1
; -1 leaves the application alone. Other valid values are 2-6.
backbuffer_count=-1

[UE5]
; UE5 overrides affect injected x64 applications only. They redirect validated
; game-thread/render-thread CVar shadows in memory, never Engine.ini or game
; files, and remain authoritative across map, scalability, and config reloads.
; Missing CVars from older UE/plugin builds are logged and skipped safely.
; Injecting/overriding engine or vendor features is not anti-cheat safe, so leave
; these settings off for competitive online games.
;
; When the game already contains a capable NVIDIA Ray Reconstruction integration,
; this selects its r.NGX.DLSS.DenoiserMode=1 path. It cannot add missing RR render
; inputs or make unsupported hardware/runtime combinations work. A compatible
; nvngx_dlssd.dll can still be selected with [DLSS] dlss_rr_dll_path below.
force_ray_reconstruction=off
;
; Applies a graduated Ray Reconstruction quality-settings preset. It does not
; select the RR denoiser; use force_ray_reconstruction=on separately when wanted.
; off applies none of these settings. light applies:
; r.Lumen.Reflections.BilateralFilter=0
; r.Lumen.Reflections.ScreenSpaceReconstruction=0
; r.Lumen.Reflections.Temporal=0
; r.SSR.Temporal=0
; medium applies all light settings and additionally:
; r.Lumen.Reflections.DownsampleFactor=1
; full applies all medium settings and additionally:
; r.Lumen.Reflections.DownsampleCheckerboard=0
; r.Lumen.Reflections.MaxRayIntensity=100
; r.Lumen.ScreenProbeGather.StochasticInterpolation=0
; r.Lumen.ScreenProbeGather.SpatialFilterProbes=1
; r.Lumen.ScreenProbeGather.SpatialFilterNumPasses=3
; r.Lumen.ScreenProbeGather.Temporal.MaxFramesAccumulated=10
; r.Lumen.ScreenProbeGather.Temporal.MaxRayDirections=8
; r.Lumen.ScreenProbeGather.Temporal.RejectBasedOnNormal=0
; r.Lumen.ScreenProbeGather.Temporal.FastUpdateModeUseNeighborhoodClamp=0
; r.Lumen.ScreenProbeGather.TracingOctahedronResolution=16
; r.Lumen.ScreenProbeGather.RadianceCache.NumProbesToTraceBudget=600
; r.Lumen.ScreenProbeGather.RadianceCache.ProbeResolution=32
; r.Lumen.ScreenProbeGather.ShortRangeAO.ApplyDuringIntegration=0
; r.LumenScene.Radiosity.Temporal.MaxFramesAccumulated=4
; r.LumenScene.Radiosity.UpdateFactor=16
; r.LumenScene.DirectLighting.UpdateFactor=16
; r.Shadow.Virtual.SMRT.RayCountDirectional=12
; r.Shadow.Virtual.SMRT.SamplesPerRayDirectional=4
; r.Shadow.Virtual.SMRT.RayCountLocal=12
; r.Shadow.Virtual.SMRT.SamplesPerRayLocal=4
; r.Shadow.Virtual.ResolutionLodBiasLocal=-0.5
; r.Shadow.Virtual.ResolutionLodBiasLocalMoving=0.5
; r.MegaLights.DownsampleMode=0
; r.MegaLights.NumSamplesPerPixel=8
; The legacy value on remains accepted as an alias for full.
ray_reconstruction_optimal_settings=off
;
; Optional final overrides for any CVar supported by the settings above or the
; other [UE5] options in this section. Use comma-separated name=value entries.
; Canonical CVar names are case-insensitive; underscore aliases drop a leading
; r./t. and replace dots, so tonemapper_sharpen maps to r.Tonemapper.Sharpen.
; Values must match the CVar's existing Int32/Float type. Unsupported or malformed
; entries are logged and ignored, duplicate names use the last value, and valid
; entries take precedence over all presets and dedicated options. Decimal values
; use a dot because commas separate entries. off applies no custom overrides.
; Example: r.NGX.DLSS.DenoiserMode=1,r.SSR.Temporal=0,tonemapper_sharpen=0.5
custom_cvar_overrides=off
;
; Disables UE's built-in tonemapper sharpen, film grain (including tonemapper
; grain quantization), vignette, motion blur, and chromatic aberration without
; lowering r.Tonemapper.Quality. It uses the dedicated engine CVars and show flags.
; Arbitrary game-authored post-process materials have no generic semantic marker,
; so they are left intact instead of disabling every custom material and breaking
; unrelated effects such as damage, underwater, or accessibility rendering.
disable_post_processing_effects=off
;
; default follows the game, except that the disable bundle above selects 0.
; A number from 0 to 10 persistently sets r.Tonemapper.Sharpen and takes precedence
; over disable_post_processing_effects, allowing the other effects to stay off.
tonemapper_sharpen=default
;
; Overrides UE5's own engine frame rate limiter (t.MaxFPS) in memory. This is
; separate from CaptureEngine's own fps limiter ([FpsLimiter] / capture sync);
; the two pace different stages and can be active at the same time. default
; leaves the engine limiter alone, off (or 0) disables it, and a number from 1
; to 1000 caps the engine frame rate. Fractional values such as 59.94 are
; accepted because UE's t.MaxFPS is a float.
internal_fps_limit=default
;
; Overrides UE5's internal anisotropic filtering with one shared level: both
; r.MaxAnisotropy and r.VT.MaxAnisotropy are set to the same value. This is
; separate from the general [Graphics] anisotropic_filtering override, which
; forces sampler states. off or 1x disables anisotropic filtering, then 2x, 4x,
; 8x, or 16x select the level. default leaves the engine alone.
internal_anisotropic_filtering=default
;
; Overrides UE5's own texture mip bias (r.MipMapLODBias), which shifts which
; mip level all 2D textures sample from. Negative values sharpen (at the cost of
; aliasing and shimmer), positive values blur. UE accepts -15.0 to 15.0, and
; fractional values are accepted because the CVar is a float.
; This is separate from the general [Graphics] mip_bias / mip_mapping overrides,
; which act on API sampler state: this one changes what the engine itself asks
; for, so it also affects which mips texture streaming loads.
; default leaves the engine alone. Note that 0 is a real setting here (no bias),
; not a synonym for default.
internal_texture_mip_bias=default
;
; Overrides UE5's display gamma transform, for games whose own gamma/display
; option is missing or does not work.
; srgb selects UE's piecewise sRGB/Rec709 curve (the usual "sRGB display" choice).
; A number from 1.0 to 3.0 selects a pure power curve of that exponent, so 2.2 is
; the usual "gamma 2.2 display" choice. default leaves the engine alone.
; Under the hood this drives r.TonemapperGamma, plus r.HDR.Display.OutputDevice
; for the sRGB direction. The output-device write is applied only when the game
; is already on an SDR device (sRGB, Rec709 or explicit gamma), so this can never
; pull an HDR game out of HDR output - with HDR active the option does nothing.
; It is also held back while hdr_output=on below, so the two never contradict.
display_gamma=default
;
; Overrides UE5's own depth of field (r.DepthOfFieldQuality, where the engine
; documents 0 as "Off" and 2 as its default quality). off disables depth of
; field, on restores the engine default, default leaves the game alone.
; on only re-enables the engine's depth of field; it cannot add blur to a game
; whose post-process settings configure none.
depth_of_field=default
;
; Forces UE5's DLSS Super Resolution, for a game whose binary already ships the
; NVIDIA DLSS plugin but never offers DLSS in its options menu.
; off is the plugin's own switch: r.NGX.DLSS.Enable=0.
; on sets that switch and additionally moves the engine levers that decide
; whether a third-party temporal upscaler runs at all, which is what such a game
; never does by itself:
; r.NGX.Enable=1
; r.NGX.DLSS.Enable=1
; r.TemporalAA.Upscaler=1
; r.AntiAliasingMethod=2 (TAA - UE only routes third-party upscalers through that
;   path, so a game rendering with TSR is moved off TSR while this is on)
; This cannot add the plugin to a binary that lacks it, supply nvngx_dlss.dll, or
; make an unsupported GPU/driver combination work. A compatible DLL can still be
; selected with [DLSS] dlss_sr_dll_path, and presets in the [DLSS] section apply
; as usual.
dlss_super_resolution=default
;
; Quality mode for dlss_super_resolution=on, expressed as UE's screen percentage
; (r.ScreenPercentage) because that is what the plugin resolves into its quality
; modes: dlaa (100), ultra_quality (77), quality (66.67), balanced (58),
; performance (50), ultra_performance (33.33). A number from 25 to 100 sets the
; screen percentage directly. default leaves the game's own screen percentage
; alone, in which case the game decides the render resolution and an unchanged
; 100% means DLAA. Only written while dlss_super_resolution=on.
dlss_super_resolution_quality=default
;
; Forces UE5's HDR output (r.HDR.EnableHDROutput) on or off, for games that
; support HDR in the engine but do not expose the option. The engine reads this
; where it creates or reconfigures its swap chain, so it takes effect at game
; start; changing it while a game runs may only apply on the next display or
; resolution change. It needs an HDR-capable display in HDR mode - it cannot
; invent HDR output on an SDR display. default leaves the game alone.
hdr_output=default
;
; HDR display parameters, in the units UE's own CVars document. They apply
; whether HDR was enabled by the game itself or by hdr_output above, and each one
; independently leaves the engine alone at default.
; Peak display brightness in nits (r.HDR.Display.MaxLuminance), 80 to 10000.
hdr_peak_luminance=default
; Paper white in nits: the display output level UE maps 18% gray to
; (r.HDR.Display.MidLuminance), 20 to 1000.
hdr_paper_white=default
; UI and HUD brightness in nits (r.HDR.UI.Luminance), 20 to 1000. Older UE builds
; do not have this CVar; it is then logged as missing and skipped.
hdr_ui_luminance=default
; Black floor in nits (r.HDR.Display.MinLuminanceLog10 - CaptureEngine converts
; the nits to the log10 level that CVar stores), 0.0001 to 10.
hdr_min_luminance=default
; Output color gamut (r.HDR.Display.ColorGamut): rec709, dcip3, rec2020, aces or
; acescg.
hdr_color_gamut=default

[DLSS]
; DLSS overrides affect injected applications only. default leaves the game alone.
; auto exposure and exposure normalization accept default, on, or off.
dlss_auto_exposure=default
dlss_exposure_normalization=default
; Presets accept A-Z or default.
dlss_preset_dlaa=default
dlss_preset_quality=default
dlss_preset_balanced=default
dlss_preset_performance=default
dlss_preset_ultra_performance=default
dlss_preset_ultra_quality=default
; This older setting is a fallback for all SR quality modes. A per-mode setting
; above takes precedence.
dlss_sr_preset=default
dlss_rr_preset_dlaa=default
dlss_rr_preset_quality=default
dlss_rr_preset_balanced=default
dlss_rr_preset_performance=default
dlss_rr_preset_ultra_performance=default
dlss_rr_preset_ultra_quality=default
; This older setting is a fallback for all Ray Reconstruction quality modes. A
; per-mode setting above takes precedence.
dlss_rr_preset=default
; Sharpening accepts default, off, or a value from 0 to 1.
dlss_sharpening=default
; Frame-generation multiplier: default, 2x, 3x, or 4x.
dlss_fg_factor=default
; Frame-generation render preset letter: default, or A-Z. NVIDIA ships A and B
; so far (A disables and B enables the runtime's UI recomposition); later letters
; are accepted here and take effect once a runtime defines them. Unlike the SR/RR
; presets above, the game never sets this one: nvngx_dlssg.dll reads it from the
; NVIDIA driver settings, so CaptureEngine answers that read inside the game
; process only. Nothing is written to your driver profiles. Requires a DLSS frame
; generation runtime of 310.6 or newer; older ones ignore presets entirely.
dlss_fg_preset=default
; NVIDIA's on-screen DLSS indicator (super resolution and frame generation).
; default leaves the machine's ShowDlssIndicator registry setting alone; on and
; off answer the NGX runtime's probe inside the game process only, so nothing is
; written to the registry and other applications are unaffected.
dlss_debug_overlay=default
; The DLL path overrides below are implemented by CaptureEngine's injected hook.
; They are not NVIDIA's official DLL override feature and are not anti-cheat safe.
; Read the safe/unsafe application-profile examples at the end before using them.
; Empty uses the normal DLL search path. Use an absolute DLL or folder path here.
dlss_sr_dll_path=
dlss_rr_dll_path=
dlss_fg_dll_path=
; streamline_dll_path substitutes the sl.* plugin set only WITHIN one Streamline API
; generation, and CaptureEngine refuses a substitution that would cross generations.
; Streamline 1.x and 2.x are not interchangeable: a 1.x game (The Witcher 3 ships
; sl.interposer 1.5.6) imports slSetFeatureConstants, slGetFeatureSettings,
; slSetFeatureEnabled, slIsFeatureEnabled and slGetFeatureConfiguration, none of which a
; 2.x interposer exports, so the loader would kill the process before its first frame;
; and slSetTag / slEvaluateFeature have completely different signatures in each. A 1.x
; title therefore cannot be "upgraded" to Streamline 2.x by pointing this at a newer SDK.
; Changing generation at all needs a translation shim that exports the old API and calls
; the new one, installed ahead of the game's own import - that is what the third-party
; Witcher 3 MFG bridges do (they patch the executable's import to their own bridge DLL and
; keep Streamline 2.x in a side folder). CaptureEngine cooperates with such a bridge: it
; matches Streamline modules by base name regardless of folder, so the bridged 2.x runtime
; is detected and hooked normally, and this override then works within that 2.x set.
; Without a bridge, what does upgrade a 1.x title is the NGX runtime, which is
; generation-independent: use dlss_sr_dll_path (nvngx_dlss.dll) and dlss_fg_dll_path
; (nvngx_dlssg.dll) above - or streamline_upgrade below, which is CaptureEngine's own
; in-process version of that shim.
streamline_dll_path=
; streamline_upgrade=on stops treating streamline_dll_path as a DLL substitution and runs
; that folder's Streamline 2.x runtime as a SECOND, CaptureEngine-owned runtime beside the
; game's own 1.x one, then repoints the game's sl.interposer import slots at CaptureEngine
; so 1.x calls are translated to 2.x, making DLSS-G / multi-frame generation reachable in a
; title that shipped Streamline 1.x. Nothing on disk is renamed or patched - unlike the
; third-party bridges above, the takeover happens in memory and disappears with the process.
; STATUS: work-in-progress and currently non-functioning. The takeover and the call
; translation are both implemented, but no 1.x title has been upgraded end-to-end yet, so
; enabling this is not expected to restore Streamline features today - treat it strictly as
; experimental.
; Two of the calls carry per-feature structs (sl::DLSSConstants, sl::DLSSGConstants) whose
; 1.x layouts NVIDIA never published for sl.interposer 1.5.6 - there is no 1.x release at
; all and the public 1.x tags stop at v1.1.1, which predates DLSS-G. CaptureEngine measured
; them from a real session rather than guessing, and still records every such payload, so a
; title whose constants differ from the measured shape shows up in the log instead of
; silently misbehaving. Anything CaptureEngine has not verified is refused rather than
; approximated, which costs that one feature instead of corrupting frame generation.
; Requirements: streamline_dll_path must point at a COMPLETE 2.x plugin set (sl.interposer,
; sl.common, sl.dlss, sl.dlss_g, sl.reflex, sl.pcl and the matching nvngx_* runtimes); a
; folder missing sl.dlss.dll cannot serve a game that also upscales. The plugin set is
; pinned to that folder, with Streamline's over-the-air plugin updates turned off, so the
; runtime you staged is the runtime that runs. No Streamline version is hard-coded anywhere:
; CaptureEngine reads the version out of the folder you point it at and declares itself to
; Streamline as that version, so replacing the DLLs with a newer set needs no config change
; and no CaptureEngine update.
; Keep dlss_sr_dll_path / dlss_fg_dll_path on the SAME folder as streamline_dll_path when
; using this. Those overrides keep working (they are NGX runtimes, not sl.* plugins, and the
; stand-down below never touches them), but a bridged Streamline resolves its own nvngx_*
; snippets out of the folder it was pinned to - so pointing them elsewhere makes load order
; decide which copy wins. CaptureEngine logs it when they disagree.
; CaptureEngine refuses to activate unless the process really is 1.x and the configured
; folder really is 2.x. A refusal leaves the process exactly as it was: half-bridged is
; worse than not bridged, so this is always all-or-nothing.
; Arriving after the game has already called slInit is NOT a refusal. CaptureEngine is
; injected into a running process, and in a 1.x DX12 title whose executable imports its
; D3D12/DXGI entry points from sl.interposer.dll, d3d12.dll - CaptureEngine's own signal
; that the game has a graphics runtime - is not even loaded until Streamline pulls it in
; from inside slInit. So that deadline could essentially never be met. What is genuinely
; irreversible is device creation, not slInit: until the game creates its device through its
; own interposer, CaptureEngine takes the imports over and then shuts the game's 1.x runtime
; back down, leaving exactly one initialised runtime in the process. If CaptureEngine did
; arrive after device creation, it says so in the log rather than leaving frame generation
; quietly absent.
; Off by default. This is more invasive than the path overrides above and is NOT anti-cheat
; safe - the same warning applies, more so.
streamline_upgrade=false

[ThirdParty]
; CaptureEngine's injected hook can load ReShade, OptiScaler, and Special K
; directly from these paths, so their DLLs do not need to be copied into every
; game folder. Empty disables a tool. Values are absolute file or folder paths:
; a folder gets the per-bitness default file name appended automatically
; (ReShade64.dll/ReShade32.dll, SpecialK64.dll/SpecialK32.dll, OptiScaler.dll),
; a value ending in a file name (contains '.') is loaded verbatim. Prefer the
; plain loader DLL names: a copy renamed to dxgi.dll/d3d*.dll acts as a proxy
; and cannot intercept a game that already resolved the system module.
; Configured tools load in the order Special K -> ReShade -> OptiScaler and any
; copy the game already loaded is kept. Before each tool after the first,
; CaptureEngine waits for the Windows loader work queue to drain and suspends
; the other process threads during the load, because the tools' initialization
; threads perform their own DLL loads and back-to-back LoadLibrary calls
; deadlock the loader otherwise. These are third-party injected DLLs and are
; not anti-cheat safe. Each tool still reads its own per-game configuration
; next to the game executable (ReShade.ini, OptiScaler.ini, Special K profile).
; Keep OptiScaler's LoadReshade/LoadSpecialK INI switches off so CaptureEngine
; stays the single loader. ReShade in Vulkan games still needs ReShade's Vulkan
; layer registered. Changing these paths requires relaunching the game.
reshade_dll_path=
optiscaler_dll_path=
specialk_dll_path=

[Performance]
; CaptureEngine process priority: idle, below_normal, normal, above_normal, high,
; or realtime. Avoid realtime for normal use because it can make Windows less
; responsive.
process_priority=high
; GPU thread priority for CaptureEngine's D3D11 devices, from -7 to 7. 0 is adaptive.
gpu_priority=7
; auto, off, idle, below_normal, normal, above_normal, high, or realtime.
; high and realtime may require administrator rights.
gpu_scheduling_priority=auto

[AudioSync]
; Usually leave these settings alone. CaptureEngine can measure how late system
; and app audio arrives and delay video to match it. It never moves live audio
; earlier. Microphones have a separate timing value.
; With autodetect enabled, audio_capture_latency_ms=0 measures the default output
; device. A positive value is a manual delay in milliseconds and skips that test.
audio_latency_autodetect=true
audio_capture_latency_ms=0
; Manual microphone timing adjustment in milliseconds. 0 leaves it unchanged.
mic_capture_latency_ms=0

[Logging]
; off, error, warn, info, debug, or trace. trace also writes the most diagnostic data.
log_level=trace
; Optional subfolder below logs for crash dumps. Empty puts dumps directly in logs.
; Absolute paths and .. are ignored here.
crash_dump_dir=

; =============================================================================
; TROUBLESHOOTING
; =============================================================================

[Diagnostics]
; Leave these at their defaults unless you are investigating a specific problem.
; Skip a WGC producer flush when capture and encoding use different devices.
wgc_skip_split_device_flush=false
; off, mandatory, or full. Changes WGC video-memory reservation experiments.
wgc_video_memory_reservation=off

; Passive and staged injected-overlay tests used by developers.
overlay_observer_only=false
overlay_observer_policy_only=false
overlay_observer_startup_present_only=false
dx12_focus_analysis=false

; =============================================================================
; APPLICATION PROFILES
; =============================================================================

; Profiles keep one application's video source, DLL injection policy, app audio, and
; setting overrides together. Use any clear name after "Profile.". There is no
; fixed limit.
;
; process is the executable name. It is needed for injection, app audio, and
; per-app overrides. window_title is optional and helps select the right window
; when one process owns several. It can also be used alone for WGC or DXGI capture.
; window_match controls window_title only: exact matches the whole title, contains
; finds the text anywhere in the title, and contains_or_class also checks the
; window's class name. It is ignored when window_title is empty.
;
; audio_enabled=true records audio from process. audio_track accepts IDs from 1
; to 255 and can contain a comma-separated list. The other audio_* fields are
; optional; when omitted, they use [Audio]. Do not put the same application on
; the same track through both system audio and app audio, or it may sound hollow
; or metallic.
;
; A profile has two kinds of keys:
; - Profile fields use the bare names shown below: process, window_title,
;   window_match, video_capture, monitor, dll_injection, and audio_*.
; - Overrides of ordinary settings keep the original section name. For example,
;   [Video] fps=60 becomes Video.fps=60, [FpsLimiter] general_fps=60 becomes
;   FpsLimiter.general_fps=120, and [DLSS] dlss_fg_factor=default becomes
;   DLSS.dlss_fg_factor=3x.
; Therefore, if a setting normally appears under [Section], write Section.key in
; a profile. Bare override keys remain readable for old configs, but can
; accidentally affect every section with the same key (such as enabled or bitrate)
; and should not be used in new profiles.
; Any [DesktopOverlay] setting can also be overridden this way. A process profile
; with a video route is automatically a NOT RECORDING warning target, so it does
; not also need to be listed in DesktopOverlay.process_list.
;
;[Profile.My Game]
;process=game.exe
; Optional. Use these only when the process name alone does not identify the
; right window.
;window_title=My Game
;window_match=contains
;
; Choose the video source for this application:
; inherit = use capture_method from [Capture]. With capture_method=auto, this
;           normally uses injected capture.
; inject = capture through the injected DLL. This also enables the injected
;          overlay and graphics overrides; no second setting is needed.
; wgc = capture this window with Windows Graphics Capture.
; dxgi_dup = capture this window's monitor with DXGI Desktop Duplication.
; none = do not capture video for this profile.
;video_capture=inherit
; Optional monitor override for monitor-scope capture: auto, primary, window,
; cursor, or id:<stable-id> from CaptureEngine.exe --list-monitors. For a DXGI
; profile, auto/window captures the monitor containing this profile's window.
;monitor=window
;
; DLL injection normally follows the selected video source: inject loads the DLL;
; wgc, dxgi_dup, and none do not. inherit follows whichever source [Capture]
; selects. dll_injection is only needed to override that behavior:
; always = also load the DLL with WGC, DXGI Duplication, or no video so the
;          injected overlay and graphics overrides can work.
; never = block DLL loading. If the selected video source is inject, this profile
;         has no video route.
; when_needed = the normal behavior described above. This value remains accepted,
;               but the setting can simply be left out.
;
; Choosing inject or always can trigger anti-cheat protection. Do not use either
; with multiplayer or anti-cheat software unless you know injection is permitted.
;
;audio_enabled=true
;audio_track=3
;audio_codec=aac
;audio_bitrate=192
;audio_sample_rate=default
;audio_bit_depth=default
;audio_downmix=false
;audio_capture_latency_ms=0
;Video.encoder=hevc_nvenc
;Video.fps=60
;Graphics.vsync_mode=off
;Graphics.nv_lod_spread_fix=on
;FpsLimiter.general_enabled=true
;FpsLimiter.general_fps=120
;DLSS.dlss_preset_quality=K
;DLSS.dlss_fg_factor=3x
;DLSS.dlss_fg_preset=B
;DLSS.dlss_debug_overlay=on
;UE5.force_ray_reconstruction=on
;UE5.ray_reconstruction_optimal_settings=full
;UE5.custom_cvar_overrides=r.SSR.Temporal=0,tonemapper_sharpen=0.5
;UE5.disable_post_processing_effects=on
;UE5.tonemapper_sharpen=0.5
;UE5.internal_fps_limit=60
;UE5.internal_anisotropic_filtering=8x
;UE5.internal_texture_mip_bias=-2
;UE5.display_gamma=srgb
;UE5.depth_of_field=off
;UE5.dlss_super_resolution=on
;UE5.dlss_super_resolution_quality=performance
;UE5.hdr_output=on
;UE5.hdr_peak_luminance=1000
;UE5.hdr_paper_white=200
;UE5.hdr_ui_luminance=200
;UE5.hdr_min_luminance=0.01
;UE5.hdr_color_gamut=rec2020
; Third-party tool paths can be overridden per application. Values follow the
; same file/folder rules as [ThirdParty] above; empty uses the global path.
; Changing them requires relaunching the game.
;ThirdParty.reshade_dll_path=C:\tools\reshade
;ThirdParty.optiscaler_dll_path=C:\tools\OptiScaler.dll
;ThirdParty.specialk_dll_path=C:\tools\specialk
;DesktopOverlay.enabled=true
;DesktopOverlay.mode=2
;DesktopOverlay.pos=0

; Example: capture Heroes of the Storm through DXGI Desktop Duplication, show the
; desktop warning, and record its audio to tracks 1 and 2. DXGI Duplication does
; not normally inject; never is an optional safety lock here.
;[Profile.hots]
;process=HeroesOfTheStorm_x64.exe
;video_capture=dxgi_dup
;dll_injection=never
;DesktopOverlay.enabled=true
;audio_enabled=true
;audio_track=1,2

; Example: capture through the injected DLL. Injection is used because the
; selected video source needs it; the injected overlay and graphics overrides
; are available as well. No dll_injection setting is needed.
;[Profile.Injected Example]
;process=InjectedGame.exe
;video_capture=inject

; Example: capture a game's monitor through DXGI Desktop Duplication while
; keeping DLL injection enabled for the injected overlay and graphics overrides.
;[Profile.DXGI Overlay Example]
;process=DxgiOverlayGame.exe
;video_capture=dxgi_dup
;dll_injection=always
;
;
; ANTI-CHEAT SAFETY — these examples contrast safe and unsafe configurations.
;
; SAFE: WGC capture, no injection. Works with most anti-cheat software.
;[Profile.Safe WGC Example]
;process=SafeGame.exe
;video_capture=wgc
;dll_injection=never
;Capture.black_when_no_fullscreen_focus=true
;DesktopOverlay.enabled=true
;DesktopOverlay.mode=2
;
; SAFE: DXGI Desktop Duplication, no injection. No DLL is loaded.
;[Profile.Safe DXGI Example]
;process=AnotherSafeGame.exe
;video_capture=dxgi_dup
;dll_injection=never
;Capture.black_when_no_fullscreen_focus=true
;
; UNSAFE: inject capture loads the DLL into the game process, which anti-cheat
; software detects as code injection. Do NOT use with multiplayer or anti-cheat.
;[Profile.Unsafe Inject Example]
;process=UnsafeGame.exe
;video_capture=inject
; Never add dll_injection=never here — inject capture already requires injection.
;
; UNSAFE: inject overlay without inject capture. The DLL is loaded solely for
; the overlay. Anti-cheat still sees the injected DLL in the process.
;[Profile.Unsafe Overlay-Only Example]
;process=OverlayOnlyGame.exe
;video_capture=wgc
;dll_injection=always
; The injected overlay is now available even though video comes from WGC.
;
; UNSAFE: both inject capture AND inject overlay. Maximum anti-cheat risk.
;[Profile.Unsafe Full Inject Example]
;process=FullInjectGame.exe
;video_capture=inject
; dll_injection=always is redundant here — inject capture already implies it.
;
; SUMMARY
;   Safe:   never + wgc/dxgi_dup        — no DLL loaded
;   Unsafe: inject or always            — DLL loaded, anti-cheat trigger
;   Double unsafe: inject + always      — redundant, still just one DLL load
