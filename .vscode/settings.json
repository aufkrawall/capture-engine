{
    // Disable the Microsoft C/C++ extension IntelliSense engine in favor of clangd.
    // clangd consumes our build-generated compile_commands.json automatically.
    "C_Cpp.intelliSenseEngine": "disabled",

    // Point VS Code's clangd extension to the project-bundled MSYS2 Clang 22 binary.
    "clangd.path": "${workspaceFolder}/build/msys64/clang64/bin/clangd.exe",

    "clangd.arguments": [
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=bundled",
        "--pch-storage=memory",
        "--cross-file-rename"
    ],

    // Default formatter for C and C++ using clangd (format on save disabled to prevent
    // unintended bulk formatting of legacy source per project engineering rules).
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": false
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": false
    },

    // Keep VS Code's Git initialization and publish flow aligned with the
    // repository's protected default branch.
    "git.defaultBranchName": "main",

    // EditorConfig mirror: root .editorconfig and tools/config/.editorconfig define canonical rules.
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[bat]": {
        "files.eol": "\r\n"
    },
    "[powershell]": {
        "files.eol": "\r\n"
    },
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },

    // Pyright configuration: pyrightconfig.json is authoritative for build lint and editor analysis.
    "python.analysis.configurationPath": "pyrightconfig.json",
    "pyright.project": "pyrightconfig.json",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.pythonVersion": "3.10",
    "python.analysis.include": [
        "build.py",
        "tools",
        "testapp"
    ],
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "build/msys64",
        ".venv",
        "build",
        "installed",
        "**/*_part_*.py",
        "**/analyze_capture_av_*.py",
        "**/analyze_av_sync_stimulus_*.py",
        "**/run_av_sync_matrix_*.py",
        "**/run_dx12_fg_overlay_transition_*.py",
        "**/run_tests_*.py",
        "tools/build",
        "tools/refactor/source_splitter_common.py",
        "tools/refactor/source_splitter_lexer.py",
        "tools/refactor/source_splitter_scanner.py",
        "tools/refactor/source_splitter_split.py"
    ],

    // File-association helpers so VS Code treats headers and shaders consistently
    "files.associations": {
        "*.h": "cpp",
        "*.inl": "cpp",
        "*.hlsl": "hlsl"
    }
}
