{
    // Disable the Microsoft C/C++ extension IntelliSense engine in favor of clangd.
    // clangd consumes our build-generated compile_commands.json automatically.
    "C_Cpp.intelliSenseEngine": "disabled",

    // Point VS Code's clangd extension to the OpenCode-shipped binary.
    // OpenCode bundles clangd under the user profile cache so it is always
    // available even before the MSYS2 build environment is fully set up.
    "clangd.path": "${env:USERPROFILE}/.cache/opencode/bin/clangd",

    "clangd.arguments": [
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=bundled",
        "--pch-storage=memory",
        "--cross-file-rename"
    ],

    // EditorConfig mirror: the committed config lives in tools/config/.editorconfig,
    // which editors cannot discover from a non-root location.
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[bat]": {
        "files.eol": "\r\n"
    },
    "[powershell]": {
        "files.eol": "\r\n"
    },
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },

    // Pyright mirror: tools/config/pyrightconfig.json is authoritative for
    // build lint; these settings keep the editor on the same scope.
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.pythonVersion": "3.10",
    "python.analysis.include": [
        "build.py",
        "tools",
        "testapp"
    ],
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "build/msys64",
        ".venv",
        "build",
        "installed",
        "**/*_part_*.py"
    ],

    // File-association helpers so VS Code treats headers consistently
    "files.associations": {
        "*.h": "cpp",
        "*.inl": "cpp"
    }
}
