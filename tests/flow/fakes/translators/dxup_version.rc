// The DXUP stand-in's version resource: DXUP's DLLs carry ProductName "DXUP" (1.1.0, 2026-10-22).
1 VERSIONINFO
FILEVERSION 1, 1, 0, 0
PRODUCTVERSION 1, 1, 0, 0
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Direct3D 9 frontend stand-in (CaptureEngine flow tests)"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductName", "DXUP"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
