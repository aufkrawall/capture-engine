// The ReShade stand-in's version resource: another d3d9.dll replacement, which is not DXUP.
1 VERSIONINFO
FILEVERSION 6, 3, 3, 0
PRODUCTVERSION 6, 3, 3, 0
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "crosire's ReShade post-processing injector stand-in (CaptureEngine flow tests)"
            VALUE "FileVersion", "6.3.3.0"
            VALUE "ProductName", "ReShade"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
