// File version of every fake Streamline module: CE reads the API generation from the major version.
1 VERSIONINFO
FILEVERSION 2, 7, 32, 0
PRODUCTVERSION 2, 7, 32, 0
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CaptureEngine FG flow-test fake of NVIDIA Streamline"
            VALUE "FileVersion", "2.7.32.0"
            VALUE "ProductName", "CaptureEngine flow tests"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
