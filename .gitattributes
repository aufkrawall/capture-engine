* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

*.png binary
*.ico binary
*.dll binary
*.exe binary
*.spv binary
*.a binary
*.lib binary
*.pdf binary

# Fuzz seeds must stay byte-exact. Several deliberately carry CRLF, a BOM, an
# embedded NUL, or invalid UTF-8; EOL normalisation would silently rewrite the
# very inputs they exist to cover.
tests/fuzz/corpus/** -text
